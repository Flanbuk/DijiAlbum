# ==============================================================================
# DijiAlbum - Environment Variables Template
# ==============================================================================
# Fill in your own Supabase project details to run the project locally.
# Never commit real keys or production connection strings to Git.

# Supabase API URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon Public Key (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key
